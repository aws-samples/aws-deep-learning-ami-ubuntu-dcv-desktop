# Qwen3-32B on trn2, the published AWS vllm-neuron recipe (BF16, TP8 at LNC2, one bucket each).
# The control configuration; valid for concurrency <= 4 per replica.
MODEL_DIR=${MODEL_DIR:-$HOME/snapshots/Qwen3-32B}
NEURON_VLLM_STACK=${NEURON_VLLM_STACK:-native}
TENSOR_PARALLEL_SIZE=${TENSOR_PARALLEL_SIZE:-8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-10240}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-4}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
BUCKET_PROFILE=${BUCKET_PROFILE:-recipe}
PREFIX_CACHING=${PREFIX_CACHING:-false}
