# Qwen3-32B on trn2 for an SLO sweep over concurrency 1-16 and prompts up to 8k.
# MAX_NUM_SEQS stays below the scheduler's KV admission cap (about 21 at MAX_MODEL_LEN
# 10240): requests above the cap only queue.
MODEL_DIR=${MODEL_DIR:-$HOME/snapshots/Qwen3-32B}
NEURON_VLLM_STACK=${NEURON_VLLM_STACK:-native}
TENSOR_PARALLEL_SIZE=${TENSOR_PARALLEL_SIZE:-8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-10240}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-16}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
BUCKET_PROFILE=${BUCKET_PROFILE:-ladder}
PREFIX_CACHING=${PREFIX_CACHING:-false}
